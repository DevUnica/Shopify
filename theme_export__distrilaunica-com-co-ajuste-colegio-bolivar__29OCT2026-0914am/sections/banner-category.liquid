{% comment %}
  ============================================================
  GRID DE CATEGORÍAS VISUAL
  - Grid editable en desktop
  - Carrusel táctil en móvil
  - Tipografía heredada automáticamente del theme.css
  - Tamaño de título independiente desktop / móvil
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id = 'category-grid-' | append: section.id
-%}

<style>

  /* =========================================================
     CONFIGURACIÓN GENERAL
  ========================================================= */

  #{{ section_id }} {
    --section-max-width: {{ section.settings.max_width }}px;
    --section-gap: {{ section.settings.gap }}px;
    --card-height: {{ section.settings.card_height }}px;
    --card-radius: {{ section.settings.border_radius }}px;

    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-x: {{ section.settings.padding_horizontal }}px;

    width: 100%;

    padding:
      var(--section-padding-top)
      var(--section-padding-x)
      var(--section-padding-bottom);

    background: {{ section.settings.background_color }};
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .category-grid__container {
    width: 100%;
    max-width: var(--section-max-width);
    margin: 0 auto;
  }


  /* =========================================================
     GRID DESKTOP
  ========================================================= */

  #{{ section_id }} .category-grid__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--section-gap);
    width: 100%;
  }


  /* =========================================================
     TARJETAS
  ========================================================= */

  #{{ section_id }} .category-grid__card {
    position: relative;

    min-width: 0;
    height: var(--card-height);

    overflow: hidden;

    border-radius: var(--card-radius);

    isolation: isolate;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  #{{ section_id }} .category-grid__card--25 {
    grid-column: span 3;
  }

  #{{ section_id }} .category-grid__card--33 {
    grid-column: span 4;
  }

  #{{ section_id }} .category-grid__card--50 {
    grid-column: span 6;
  }

  #{{ section_id }} .category-grid__card--66 {
    grid-column: span 8;
  }

  #{{ section_id }} .category-grid__card--75 {
    grid-column: span 9;
  }

  #{{ section_id }} .category-grid__card--100 {
    grid-column: span 12;
  }


  /* =========================================================
     FONDO
  ========================================================= */

  #{{ section_id }} .category-grid__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #{{ section_id }} .category-grid__background-color {
    position: absolute;
    inset: 0;
    background: var(--card-bg);
  }

  #{{ section_id }} .category-grid__background-image {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position:
      var(--background-x)
      var(--background-y);
  }


  /* =========================================================
     OVERLAY
  ========================================================= */

  #{{ section_id }} .category-grid__overlay {
    position: absolute;
    inset: 0;

    z-index: 1;

    background: var(--overlay-color);
    opacity: var(--overlay-opacity);

    pointer-events: none;
  }


  /* =========================================================
     CONTENIDO
  ========================================================= */

  #{{ section_id }} .category-grid__content {
    position: absolute;
    inset: 0;

    z-index: 3;

    pointer-events: none;
  }


  /* =========================================================
     TÍTULO

     IMPORTANTE:
     No se establece:
     - font-family
     - font-weight
     - font-style

     Al ser un H3 toma automáticamente la fuente de encabezados
     configurada por el theme / theme.css.
  ========================================================= */

  #{{ section_id }} .category-grid__title {
    position: absolute;

    z-index: 6;

    left: var(--title-left);
    top: var(--title-top);

    transform:
      translate(
        var(--title-translate-x),
        var(--title-translate-y)
      );

    max-width: calc(100% - 20px);

    margin: 0;

    font-size: var(--title-size);

    text-align: var(--title-align);

    color: var(--title-color);

    -webkit-text-stroke:
      var(--title-stroke-width)
      var(--title-stroke-color);

    paint-order: stroke fill;

    text-shadow:
      var(--title-shadow-x)
      var(--title-shadow-y)
      var(--title-shadow-blur)
      var(--title-shadow-color);

    white-space: normal;

    word-break: normal;

    pointer-events: none;
  }


  /* =========================================================
     IMAGEN PRINCIPAL
  ========================================================= */

  #{{ section_id }} .category-grid__image-wrapper {
    position: absolute;

    z-index: 5;

    left: var(--image-left);
    top: var(--image-top);

    width: var(--image-width);
    height: var(--image-height);

    transform:
      translate(
        var(--image-translate-x),
        var(--image-translate-y)
      )
      rotate(var(--image-rotation));

    transform-origin: center;

    transition: transform 0.35s ease;

    pointer-events: none;
  }

  #{{ section_id }} .category-grid__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;
  }


  /* =========================================================
     LINK
  ========================================================= */

  #{{ section_id }} .category-grid__link {
    position: absolute;
    inset: 0;

    z-index: 20;

    display: block;
  }


  /* =========================================================
     HOVER DESKTOP
  ========================================================= */

  @media (hover: hover) and (pointer: fine) {

    #{{ section_id }}
    .category-grid__card[data-hover="lift"]:hover {
      transform: translateY(-5px);
    }

    #{{ section_id }}
    .category-grid__card[data-hover="shadow"]:hover {
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.16);
    }

    #{{ section_id }}
    .category-grid__card[data-hover="zoom"]:hover
    .category-grid__image-wrapper {
      transform:
        translate(
          var(--image-translate-x),
          var(--image-translate-y)
        )
        rotate(var(--image-rotation))
        scale(1.05);
    }

  }


  /* =========================================================
     CONTROLES CARRUSEL
  ========================================================= */

  #{{ section_id }} .category-carousel__controls {
    display: none;
  }

  #{{ section_id }} .category-carousel__arrows {
    display: flex;

    align-items: center;

    gap: 8px;
  }

  #{{ section_id }} .category-carousel__arrow {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    padding: 0;

    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 50%;

    background: #ffffff;
    color: #111111;

    cursor: pointer;

    font-size: 25px;
    line-height: 1;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  #{{ section_id }} .category-carousel__arrow:active {
    transform: scale(0.94);
  }


  /* =========================================================
     DOTS
  ========================================================= */

  #{{ section_id }} .category-carousel__dots {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    flex-wrap: wrap;
  }

  #{{ section_id }} .category-carousel__dot {
    display: block;

    width: 8px;
    height: 8px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: rgba(0, 0, 0, 0.22);

    cursor: pointer;

    transition:
      width 0.25s ease,
      border-radius 0.25s ease,
      background 0.25s ease;
  }

  #{{ section_id }} .category-carousel__dot.is-active {
    width: 24px;

    border-radius: 20px;

    background: rgba(0, 0, 0, 0.75);
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 989px) and (min-width: 750px) {

    #{{ section_id }} {
      --card-height: {{ section.settings.card_height_tablet }}px;
    }

    #{{ section_id }} .category-grid__card--25,
    #{{ section_id }} .category-grid__card--33,
    #{{ section_id }} .category-grid__card--50,
    #{{ section_id }} .category-grid__card--66,
    #{{ section_id }} .category-grid__card--75 {
      grid-column: span 6;
    }

    #{{ section_id }} .category-grid__card--100 {
      grid-column: span 12;
    }

  }


  /* =========================================================
     MOBILE - CARRUSEL
  ========================================================= */

  @media screen and (max-width: 749px) {

    #{{ section_id }} {

      --section-gap:
        {{ section.settings.mobile_gap }}px;

      --card-height:
        {{ section.settings.card_height_mobile }}px;

      --section-padding-top:
        {{ section.settings.mobile_padding_top }}px;

      --section-padding-bottom:
        {{ section.settings.mobile_padding_bottom }}px;

      --section-padding-x:
        {{ section.settings.mobile_padding_horizontal }}px;

    }


    /* =======================================================
       GRID PASA A SER CARRUSEL
    ======================================================= */

    #{{ section_id }} .category-grid__grid {
      display: flex;

      width: 100%;

      gap: var(--section-gap);

      overflow-x: auto;
      overflow-y: hidden;

      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;

      overscroll-behavior-x: contain;
    }

    #{{ section_id }} .category-grid__grid::-webkit-scrollbar {
      display: none;
    }


    /* =======================================================
       TARJETAS MOBILE
    ======================================================= */

    #{{ section_id }} .category-grid__card {
      grid-column: auto !important;

      flex-grow: 0;
      flex-shrink: 0;

      height: var(--card-height);

      scroll-snap-align: start;
    }


    /* =======================================================
       CANTIDAD DE TARJETAS VISIBLES
    ======================================================= */

    #{{ section_id }}[data-mobile-slides="1"]
    .category-grid__card {
      flex-basis: 100%;
    }

    #{{ section_id }}[data-mobile-slides="1.2"]
    .category-grid__card {
      flex-basis: 83%;
    }

    #{{ section_id }}[data-mobile-slides="1.4"]
    .category-grid__card {
      flex-basis: 71%;
    }

    #{{ section_id }}[data-mobile-slides="1.5"]
    .category-grid__card {
      flex-basis: 66%;
    }

    #{{ section_id }}[data-mobile-slides="2"]
    .category-grid__card {
      flex-basis:
        calc(
          (100% - var(--section-gap))
          / 2
        );
    }


    /* =======================================================
       TÍTULO MOBILE
    ======================================================= */

    #{{ section_id }} .category-grid__title {
      left: var(--mobile-title-left);
      top: var(--mobile-title-top);

      transform:
        translate(
          var(--mobile-title-translate-x),
          var(--mobile-title-translate-y)
        );

      font-size: var(--mobile-title-size);
    }


    /* =======================================================
       IMAGEN MOBILE
    ======================================================= */

    #{{ section_id }} .category-grid__image-wrapper {
      left: var(--mobile-image-left);
      top: var(--mobile-image-top);

      width: var(--mobile-image-width);
      height: var(--mobile-image-height);

      transform:
        translate(
          var(--mobile-image-translate-x),
          var(--mobile-image-translate-y)
        )
        rotate(var(--image-rotation));
    }


    /* =======================================================
       CONTROLES
    ======================================================= */

    #{{ section_id }} .category-carousel__controls {
      display: flex;

      align-items: center;

      gap: 15px;

      margin-top:
        {{ section.settings.mobile_controls_spacing }}px;

      {% if section.settings.show_mobile_arrows and section.settings.show_mobile_dots %}
        justify-content: space-between;
      {% elsif section.settings.show_mobile_dots %}
        justify-content: center;
      {% else %}
        justify-content: flex-end;
      {% endif %}
    }


    {% unless section.settings.show_mobile_arrows %}

      #{{ section_id }} .category-carousel__arrows {
        display: none;
      }

    {% endunless %}


    {% unless section.settings.show_mobile_dots %}

      #{{ section_id }} .category-carousel__dots {
        display: none;
      }

    {% endunless %}

  }

</style>


<section
  id="{{ section_id }}"
  class="category-grid-section"
  data-mobile-slides="{{ section.settings.mobile_slides }}"
  data-loop="{{ section.settings.mobile_loop }}"
>

  <div class="category-grid__container">

    <div
      class="category-grid__grid"
      data-category-carousel
    >

      {% for block in section.blocks %}

        {%- liquid

          comment
            ==================================================
            TÍTULO DESKTOP HORIZONTAL
            ==================================================
          endcomment

          case block.settings.title_horizontal

            when 'left'

              assign title_left = block.settings.title_offset_x | append: '%'
              assign title_translate_x = '0%'
              assign title_align = 'left'


            when 'center'

              assign title_left = '50%'
              assign title_translate_x = '-50%'
              assign title_align = 'center'


            when 'right'

              assign temp_title_x = 100 | minus: block.settings.title_offset_x
              assign title_left = temp_title_x | append: '%'
              assign title_translate_x = '-100%'
              assign title_align = 'right'

          endcase


          comment
            ==================================================
            TÍTULO DESKTOP VERTICAL
            ==================================================
          endcomment

          case block.settings.title_vertical

            when 'top'

              assign title_top = block.settings.title_offset_y | append: '%'
              assign title_translate_y = '0%'


            when 'center'

              assign title_top = '50%'
              assign title_translate_y = '-50%'


            when 'bottom'

              assign temp_title_y = 100 | minus: block.settings.title_offset_y
              assign title_top = temp_title_y | append: '%'
              assign title_translate_y = '-100%'

          endcase


          comment
            ==================================================
            IMAGEN DESKTOP HORIZONTAL
            ==================================================
          endcomment

          case block.settings.image_horizontal

            when 'left'

              assign image_left = block.settings.image_offset_x | append: '%'
              assign image_translate_x = '0%'


            when 'center'

              assign image_left = '50%'
              assign image_translate_x = '-50%'


            when 'right'

              assign temp_image_x = 100 | minus: block.settings.image_offset_x
              assign image_left = temp_image_x | append: '%'
              assign image_translate_x = '-100%'

          endcase


          comment
            ==================================================
            IMAGEN DESKTOP VERTICAL
            ==================================================
          endcomment

          case block.settings.image_vertical

            when 'top'

              assign image_top = block.settings.image_offset_y | append: '%'
              assign image_translate_y = '0%'


            when 'center'

              assign image_top = '50%'
              assign image_translate_y = '-50%'


            when 'bottom'

              assign temp_image_y = 100 | minus: block.settings.image_offset_y
              assign image_top = temp_image_y | append: '%'
              assign image_translate_y = '-100%'

          endcase


          comment
            ==================================================
            TÍTULO MOBILE HORIZONTAL
            ==================================================
          endcomment

          case block.settings.mobile_title_horizontal

            when 'left'

              assign mobile_title_left = block.settings.mobile_title_offset_x | append: '%'
              assign mobile_title_translate_x = '0%'


            when 'center'

              assign mobile_title_left = '50%'
              assign mobile_title_translate_x = '-50%'


            when 'right'

              assign temp_mobile_title_x = 100 | minus: block.settings.mobile_title_offset_x
              assign mobile_title_left = temp_mobile_title_x | append: '%'
              assign mobile_title_translate_x = '-100%'

          endcase


          comment
            ==================================================
            TÍTULO MOBILE VERTICAL
            ==================================================
          endcomment

          case block.settings.mobile_title_vertical

            when 'top'

              assign mobile_title_top = block.settings.mobile_title_offset_y | append: '%'
              assign mobile_title_translate_y = '0%'


            when 'center'

              assign mobile_title_top = '50%'
              assign mobile_title_translate_y = '-50%'


            when 'bottom'

              assign temp_mobile_title_y = 100 | minus: block.settings.mobile_title_offset_y
              assign mobile_title_top = temp_mobile_title_y | append: '%'
              assign mobile_title_translate_y = '-100%'

          endcase


          comment
            ==================================================
            IMAGEN MOBILE HORIZONTAL
            ==================================================
          endcomment

          case block.settings.mobile_image_horizontal

            when 'left'

              assign mobile_image_left = block.settings.mobile_image_offset_x | append: '%'
              assign mobile_image_translate_x = '0%'


            when 'center'

              assign mobile_image_left = '50%'
              assign mobile_image_translate_x = '-50%'


            when 'right'

              assign temp_mobile_image_x = 100 | minus: block.settings.mobile_image_offset_x
              assign mobile_image_left = temp_mobile_image_x | append: '%'
              assign mobile_image_translate_x = '-100%'

          endcase


          comment
            ==================================================
            IMAGEN MOBILE VERTICAL
            ==================================================
          endcomment

          case block.settings.mobile_image_vertical

            when 'top'

              assign mobile_image_top = block.settings.mobile_image_offset_y | append: '%'
              assign mobile_image_translate_y = '0%'


            when 'center'

              assign mobile_image_top = '50%'
              assign mobile_image_translate_y = '-50%'


            when 'bottom'

              assign temp_mobile_image_y = 100 | minus: block.settings.mobile_image_offset_y
              assign mobile_image_top = temp_mobile_image_y | append: '%'
              assign mobile_image_translate_y = '-100%'

          endcase

        -%}


        <div
          class="
            category-grid__card
            category-grid__card--{{ block.settings.desktop_width }}
          "
          data-hover="{{ block.settings.hover_effect }}"
          {{ block.shopify_attributes }}

          style="

            --card-bg:
              {{ block.settings.background_color }};


            --background-x:
              {{ block.settings.background_position_x }}%;

            --background-y:
              {{ block.settings.background_position_y }}%;


            --overlay-color:
              {{ block.settings.overlay_color }};

            --overlay-opacity:
              {{ block.settings.overlay_opacity | divided_by: 100.0 }};


            --title-left:
              {{ title_left }};

            --title-top:
              {{ title_top }};

            --title-translate-x:
              {{ title_translate_x }};

            --title-translate-y:
              {{ title_translate_y }};

            --title-size:
              {{ block.settings.title_size }}px;

            --title-color:
              {{ block.settings.title_color }};

            --title-stroke-width:
              {{ block.settings.title_stroke_width }}px;

            --title-stroke-color:
              {{ block.settings.title_stroke_color }};

            --title-shadow-x:
              {{ block.settings.title_shadow_x }}px;

            --title-shadow-y:
              {{ block.settings.title_shadow_y }}px;

            --title-shadow-blur:
              {{ block.settings.title_shadow_blur }}px;

            --title-shadow-color:
              {{ block.settings.title_shadow_color }};

            --title-align:
              {{ title_align }};


            --image-left:
              {{ image_left }};

            --image-top:
              {{ image_top }};

            --image-translate-x:
              {{ image_translate_x }};

            --image-translate-y:
              {{ image_translate_y }};

            --image-width:
              {{ block.settings.image_width }}%;

            --image-height:
              {{ block.settings.image_height }}%;

            --image-rotation:
              {{ block.settings.image_rotation }}deg;


            --mobile-title-left:
              {{ mobile_title_left }};

            --mobile-title-top:
              {{ mobile_title_top }};

            --mobile-title-translate-x:
              {{ mobile_title_translate_x }};

            --mobile-title-translate-y:
              {{ mobile_title_translate_y }};

            --mobile-title-size:
              {{ block.settings.mobile_title_size }}px;


            --mobile-image-left:
              {{ mobile_image_left }};

            --mobile-image-top:
              {{ mobile_image_top }};

            --mobile-image-translate-x:
              {{ mobile_image_translate_x }};

            --mobile-image-translate-y:
              {{ mobile_image_translate_y }};

            --mobile-image-width:
              {{ block.settings.mobile_image_width }}%;

            --mobile-image-height:
              {{ block.settings.mobile_image_height }}%;

          "
        >


          <!-- FONDO -->

          <div class="category-grid__background">

            <div class="category-grid__background-color"></div>

            {% if block.settings.background_image != blank %}

              {{
                block.settings.background_image
                | image_url: width: 2200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1600, 1800, 2200',
                  class: 'category-grid__background-image'
              }}

            {% endif %}

          </div>


          <!-- OVERLAY -->

          {% if block.settings.overlay_opacity > 0 %}

            <div class="category-grid__overlay"></div>

          {% endif %}


          <!-- CONTENIDO -->

          <div class="category-grid__content">


            {% if block.settings.title != blank %}

              <h3 class="category-grid__title">
                {{ block.settings.title }}
              </h3>

            {% endif %}


            {% if block.settings.product_image != blank %}

              <div class="category-grid__image-wrapper">

                {{
                  block.settings.product_image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 500, 600, 800, 1000, 1200, 1600',
                    class: 'category-grid__image'
                }}

              </div>

            {% endif %}


          </div>


          <!-- LINK -->

          {% if block.settings.link != blank %}

            <a
              href="{{ block.settings.link }}"
              class="category-grid__link"
              aria-label="{{ block.settings.title | default: 'Ver categoría' | escape }}"
            ></a>

          {% endif %}


        </div>

      {% endfor %}

    </div>


    <!-- =====================================================
         CONTROLES DEL CARRUSEL
    ====================================================== -->

    {% if section.blocks.size > 1 %}

      <div class="category-carousel__controls">


        {% if section.settings.show_mobile_dots %}

          <div
            class="category-carousel__dots"
            data-category-dots
          >

            {% for block in section.blocks %}

              <button
                type="button"
                class="
                  category-carousel__dot
                  {% if forloop.first %}is-active{% endif %}
                "
                aria-label="Ir a categoría {{ forloop.index }}"
                data-slide-index="{{ forloop.index0 }}"
              ></button>

            {% endfor %}

          </div>

        {% endif %}


        {% if section.settings.show_mobile_arrows %}

          <div class="category-carousel__arrows">

            <button
              type="button"
              class="category-carousel__arrow"
              data-category-prev
              aria-label="Categoría anterior"
            >
              ‹
            </button>

            <button
              type="button"
              class="category-carousel__arrow"
              data-category-next
              aria-label="Categoría siguiente"
            >
              ›
            </button>

          </div>

        {% endif %}


      </div>

    {% endif %}


  </div>

</section>


<script>
(function() {

  const section = document.getElementById('{{ section_id }}');

  if (!section) return;

  if (section.dataset.carouselInitialized === 'true') return;

  section.dataset.carouselInitialized = 'true';


  const carousel =
    section.querySelector('[data-category-carousel]');

  if (!carousel) return;


  const slides =
    Array.from(
      carousel.querySelectorAll('.category-grid__card')
    );

  if (slides.length <= 1) return;


  const prevButton =
    section.querySelector('[data-category-prev]');

  const nextButton =
    section.querySelector('[data-category-next]');

  const dots =
    Array.from(
      section.querySelectorAll('[data-slide-index]')
    );


  const loop =
    section.dataset.loop === 'true';


  let activeIndex = 0;

  let scrollTimer = null;


  function isMobile() {

    return window.matchMedia(
      '(max-width: 749px)'
    ).matches;

  }


  function getGap() {

    const styles =
      window.getComputedStyle(carousel);

    return (
      parseFloat(
        styles.columnGap ||
        styles.gap ||
        0
      ) || 0
    );

  }


  function getStep() {

    if (!slides[0]) return 0;

    return (
      slides[0].getBoundingClientRect().width
      + getGap()
    );

  }


  function getMaxIndex() {

    return slides.length - 1;

  }


  function updateDots(index) {

    activeIndex = Math.max(
      0,
      Math.min(index, getMaxIndex())
    );

    dots.forEach(function(dot, dotIndex) {

      const active =
        dotIndex === activeIndex;

      dot.classList.toggle(
        'is-active',
        active
      );

      if (active) {

        dot.setAttribute(
          'aria-current',
          'true'
        );

      } else {

        dot.removeAttribute(
          'aria-current'
        );

      }

    });

  }


  function scrollToSlide(index) {

    if (!isMobile()) return;


    const maxIndex =
      getMaxIndex();


    if (loop) {

      if (index < 0) {
        index = maxIndex;
      }

      if (index > maxIndex) {
        index = 0;
      }

    } else {

      index = Math.max(
        0,
        Math.min(index, maxIndex)
      );

    }


    const step =
      getStep();

    if (!step) return;


    carousel.scrollTo({
      left: step * index,
      behavior: 'smooth'
    });


    updateDots(index);

  }


  if (prevButton) {

    prevButton.addEventListener(
      'click',
      function() {

        scrollToSlide(
          activeIndex - 1
        );

      }
    );

  }


  if (nextButton) {

    nextButton.addEventListener(
      'click',
      function() {

        scrollToSlide(
          activeIndex + 1
        );

      }
    );

  }


  dots.forEach(function(dot) {

    dot.addEventListener(
      'click',
      function() {

        const index =
          parseInt(
            dot.dataset.slideIndex,
            10
          );

        if (
          Number.isNaN(index)
        ) return;

        scrollToSlide(index);

      }
    );

  });


  carousel.addEventListener(
    'scroll',
    function() {

      if (!isMobile()) return;

      window.clearTimeout(
        scrollTimer
      );

      scrollTimer =
        window.setTimeout(
          function() {

            const step =
              getStep();

            if (!step) return;


            const index =
              Math.round(
                carousel.scrollLeft
                / step
              );


            updateDots(index);

          },
          70
        );

    },
    {
      passive: true
    }
  );


  updateDots(0);

})();
</script>


