{"name":"t:sections.footer.name","type":"footer","sections":{"custom_liquid_nCLLFT":{"type":"custom-liquid","name":"t:sections.custom-liquid.name","settings":{"custom_liquid":"<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https:\/\/fonts.gstatic.com\" crossorigin>\n\n<link\n  href=\"https:\/\/fonts.googleapis.com\/css2?family=Varela+Round&display=swap\"\n  rel=\"stylesheet\"\n>\n\n<style>\n\n\/* ============================================================\n   MARCAS FAVORITAS\n   ============================================================ *\/\n\n.marcas-favoritas {\n  width: 100%;\n  background: #ffffff;\n  padding: 65px 0 55px;\n  overflow: hidden;\n}\n\n.marcas-favoritas__container {\n  width: 100%;\n  max-width: 1550px;\n  margin: 0 auto;\n  padding: 0 65px;\n  box-sizing: border-box;\n}\n\n\n\/* ============================================================\n   TÍTULO\n   ============================================================ *\/\n\n.marcas-favoritas__title {\n  margin: 0 0 45px;\n\n  text-align: center;\n\n  font-family: 'Varela Round', sans-serif;\n\n  font-size: 42px;\n  line-height: 1.15;\n\n  font-weight: 400;\n\n  letter-spacing: -1.2px;\n\n  color: #181818;\n}\n\n.marcas-favoritas__title .orange {\n  color: #7fb32c;\n}\n\n\n\/* ============================================================\n   SLIDER\n   ============================================================ *\/\n\n.marcas-favoritas__slider {\n  position: relative;\n  width: 100%;\n\n  overflow: hidden;\n\n  padding: 10px 0;\n}\n\n\n.marcas-favoritas__track {\n  display: flex;\n\n  width: 100%;\n\n  transition:\n    transform 0.65s cubic-bezier(.22, .61, .36, 1);\n\n  will-change: transform;\n}\n\n\n\/* ============================================================\n   CADA SLIDE\n   ============================================================ *\/\n\n.marcas-favoritas__slide {\n  flex: 0 0 100%;\n\n  width: 100%;\n\n  display: grid;\n\n  \/*\n     DESKTOP\n     6 columnas x 2 filas\n     = 12 marcas\n  *\/\n\n  grid-template-columns:\n    repeat(6, minmax(0, 1fr));\n\n  grid-template-rows:\n    repeat(2, 120px);\n\n  gap: 22px;\n\n  padding:\n    10px 45px;\n\n  box-sizing: border-box;\n}\n\n\n\/* ============================================================\n   TARJETA DE MARCA\n   ============================================================ *\/\n\n.marca-logo {\n  position: relative;\n\n  width: 100%;\n  height: 100%;\n\n  min-height: 100px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  padding: 12px;\n\n  box-sizing: border-box;\n\n  background: #ffffff;\n\n  border: 1px solid #eeeeee;\n\n  border-radius: 14px;\n\n  overflow: hidden;\n\n  transform:\n    translateY(0)\n    scale(1);\n\n  box-shadow:\n    0 3px 12px rgba(0, 0, 0, 0.035);\n\n  transition:\n    transform 0.35s cubic-bezier(.22, .61, .36, 1),\n    box-shadow 0.35s ease,\n    border-color 0.35s ease,\n    background 0.35s ease;\n}\n\n\n\n\/* ============================================================\n   HOVER\n   ============================================================ *\/\n\n.marca-logo:hover {\n\n  transform:\n    translateY(-6px)\n    scale(1.03);\n\n  border-color:\n    rgba(127, 179, 44, 0.40);\n\n  background:\n    #ffffff;\n\n  box-shadow:\n    0 14px 30px rgba(0, 0, 0, 0.09),\n    0 5px 15px rgba(127, 179, 44, 0.10);\n}\n\n\n.marca-logo:hover::before {\n  width: 55%;\n}\n\n\n\/* ============================================================\n   LOGO\n   ============================================================ *\/\n\n.marca-logo img {\n\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  max-width: 190px;\n  max-height: 82px;\n\n  object-fit: contain;\n  object-position: center;\n\n  transform:\n    scale(1);\n\n  transition:\n    transform 0.4s cubic-bezier(.22, .61, .36, 1);\n}\n\n\n.marca-logo:hover img {\n\n  transform:\n    scale(1.08);\n}\n\n\n\/* ============================================================\n   FLECHAS\n   ============================================================ *\/\n\n.marcas-favoritas__arrow {\n\n  position: absolute;\n\n  top: 50%;\n\n  transform:\n    translateY(-50%);\n\n  width: 50px;\n  height: 50px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  padding: 0;\n\n  border:\n    1px solid #eeeeee;\n\n  border-radius: 50%;\n\n  background:\n    rgba(255, 255, 255, 0.98);\n\n  color:\n    #7fb32c;\n\n  box-shadow:\n    0 5px 18px rgba(0, 0, 0, 0.10);\n\n  cursor: pointer;\n\n  z-index: 10;\n\n  transition:\n    transform 0.25s ease,\n    box-shadow 0.25s ease,\n    background 0.25s ease,\n    border-color 0.25s ease;\n}\n\n\n.marcas-favoritas__arrow:hover {\n\n  transform:\n    translateY(-50%)\n    scale(1.10);\n\n  background:\n    #ffffff;\n\n  border-color:\n    rgba(127, 179, 44, 0.35);\n\n  box-shadow:\n    0 8px 25px rgba(127, 179, 44, 0.18);\n}\n\n\n.marcas-favoritas__arrow span {\n\n  font-size: 34px;\n\n  font-weight: 300;\n\n  line-height: 1;\n\n  margin-top: -3px;\n}\n\n\n.marcas-favoritas__arrow--prev {\n  left: 0;\n}\n\n\n.marcas-favoritas__arrow--next {\n  right: 0;\n}\n\n\n\/* ============================================================\n   INDICADORES\n   ============================================================ *\/\n\n.marcas-favoritas__dots {\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 7px;\n\n  margin-top: 25px;\n}\n\n\n.marcas-favoritas__dot {\n\n  width: 8px;\n  height: 8px;\n\n  padding: 0;\n\n  border: 0;\n\n  border-radius: 20px;\n\n  background:\n    #d7d7d7;\n\n  cursor: pointer;\n\n  transition:\n    width 0.3s ease,\n    background 0.3s ease;\n}\n\n\n.marcas-favoritas__dot.active {\n\n  width: 28px;\n\n  background:\n    #7fb32c;\n}\n\n\n\/* ============================================================\n   TABLET\n   8 MARCAS POR PÁGINA\n   4 COLUMNAS x 2 FILAS\n   ============================================================ *\/\n\n@media screen and (max-width: 1000px) {\n\n  .marcas-favoritas {\n\n    padding:\n      50px 0 40px;\n  }\n\n\n  .marcas-favoritas__container {\n\n    padding:\n      0 55px;\n  }\n\n\n  .marcas-favoritas__title {\n\n    font-size:\n      34px;\n\n    margin-bottom:\n      35px;\n  }\n\n\n  .marcas-favoritas__slide {\n\n    grid-template-columns:\n      repeat(4, minmax(0, 1fr));\n\n    grid-template-rows:\n      repeat(2, 115px);\n\n    gap:\n      18px;\n\n    padding:\n      10px 25px;\n  }\n\n\n  .marca-logo {\n\n    min-height:\n      105px;\n\n    padding:\n      12px;\n  }\n\n\n  .marca-logo img {\n\n    max-width:\n      150px;\n\n    max-height:\n      75px;\n  }\n\n}\n\n\n\/* ============================================================\n   MÓVIL\n   4 MARCAS POR PÁGINA\n   2 COLUMNAS x 2 FILAS\n   ============================================================ *\/\n\n@media screen and (max-width: 600px) {\n\n  .marcas-favoritas {\n\n    padding:\n      38px 0 30px;\n  }\n\n\n  .marcas-favoritas__container {\n\n    padding:\n      0 38px;\n  }\n\n\n  .marcas-favoritas__title {\n\n    font-size:\n      25px;\n\n    letter-spacing:\n      -0.5px;\n\n    margin-bottom:\n      25px;\n  }\n\n\n  .marcas-favoritas__slider {\n\n    padding:\n      7px 0;\n  }\n\n\n  .marcas-favoritas__slide {\n\n    grid-template-columns:\n      repeat(2, minmax(0, 1fr));\n\n    grid-template-rows:\n      repeat(2, 100px);\n\n    gap:\n      13px;\n\n    padding:\n      6px;\n  }\n\n\n  .marca-logo {\n\n    min-height:\n      90px;\n\n    padding:\n      8px;\n\n    border-radius:\n      11px;\n  }\n\n\n  .marca-logo img {\n\n    max-width:\n      110px;\n\n    max-height:\n      62px;\n  }\n\n\n  .marca-logo:hover {\n\n    transform:\n      translateY(-3px)\n      scale(1.015);\n\n    box-shadow:\n      0 8px 20px rgba(0, 0, 0, 0.08),\n      0 4px 12px rgba(127, 179, 44, 0.10);\n  }\n\n\n  .marca-logo:hover img {\n\n    transform:\n      scale(1.05);\n  }\n\n\n  .marca-logo:hover::before {\n\n    width:\n      45%;\n  }\n\n\n  \/* ========================================================\n     FLECHAS MÓVIL\n     ======================================================== *\/\n\n  .marcas-favoritas__arrow {\n\n    width:\n      34px;\n\n    height:\n      40px;\n\n    border-radius:\n      8px;\n  }\n\n\n  .marcas-favoritas__arrow span {\n\n    font-size:\n      27px;\n  }\n\n\n  .marcas-favoritas__arrow--prev {\n\n    left:\n      0;\n  }\n\n\n  .marcas-favoritas__arrow--next {\n\n    right:\n      0;\n  }\n\n\n  \/* ========================================================\n     DOTS MÓVIL\n     ======================================================== *\/\n\n  .marcas-favoritas__dots {\n\n    margin-top:\n      20px;\n  }\n\n\n  .marcas-favoritas__dot {\n\n    width:\n      7px;\n\n    height:\n      7px;\n  }\n\n\n  .marcas-favoritas__dot.active {\n\n    width:\n      21px;\n  }\n\n}\n\n\n\/* ============================================================\n   PANTALLAS MUY PEQUEÑAS\n   ============================================================ *\/\n\n@media screen and (max-width: 380px) {\n\n  .marcas-favoritas__container {\n\n    padding:\n      0 32px;\n  }\n\n\n  .marcas-favoritas__slide {\n\n    gap:\n      10px;\n  }\n\n\n  .marca-logo {\n\n    min-height:\n      84px;\n  }\n\n\n  .marca-logo img {\n\n    max-width:\n      95px;\n\n    max-height:\n      55px;\n  }\n\n}\n\n\n\/* ============================================================\n   REDUCIR ANIMACIONES\n   ============================================================ *\/\n\n@media (prefers-reduced-motion: reduce) {\n\n  .marca-logo,\n  .marca-logo img,\n  .marca-logo::before,\n  .marcas-favoritas__arrow,\n  .marcas-favoritas__dot,\n  .marcas-favoritas__track {\n\n    transition:\n      none !important;\n  }\n\n\n  .marca-logo:hover {\n\n    transform:\n      none;\n  }\n\n\n  .marca-logo:hover img {\n\n    transform:\n      scale(1.03);\n  }\n\n}\n\n<\/style>\n\n\n<!-- ============================================================\n     SECCIÓN\n     ============================================================ -->\n\n<section\n  class=\"marcas-favoritas\"\n  id=\"marcas-favoritas-{{ section.id }}\"\n>\n\n  <div class=\"marcas-favoritas__container\">\n\n\n    <!-- ========================================================\n         TÍTULO\n         ======================================================== -->\n\n    <h2 class=\"marcas-favoritas__title\">\n\n      Tus marcas\n\n      <span class=\"orange\">\n        favoritas\n      <\/span>\n\n    <\/h2>\n\n\n    <!-- ========================================================\n         CARRUSEL\n         ======================================================== -->\n\n    <div class=\"marcas-favoritas__slider\">\n\n      <div class=\"marcas-favoritas__track\">\n\n\n        <!-- ====================================================\n             LAS 24 MARCAS\n             ==================================================== -->\n\n        <div class=\"marcas-favoritas__slide\">\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/1Norma.webp\"\n              alt=\"Norma\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/2Scribe.webp\"\n              alt=\"Scribe\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/3primavera.webp\"\n              alt=\"Marca 3\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/4totto.webp\"\n              alt=\"Marca 4\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/5kiut.webp\"\n              alt=\"Marca 5\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/6incolors.webp\"\n              alt=\"Marca 6\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/7xtrem.webp\"\n              alt=\"Marca 7\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/8fabercastell.webp\"\n              alt=\"Marca 8\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/9sharpie.webp\"\n              alt=\"Marca 9\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/10papermate.webp\"\n              alt=\"Marca 10\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/11%20prismacolor.webp\"\n              alt=\"Marca 11\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/12crayola.webp\"\n              alt=\"Marca 12\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n        <\/div>\n\n\n        <!-- ====================================================\n             SLIDE 2\n             ==================================================== -->\n\n        <div class=\"marcas-favoritas__slide\">\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/13edding.webp\"\n              alt=\"Marca 13\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/14tesa.webp\"\n              alt=\"Marca 14\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/15pegastic.webp\"\n              alt=\"Marca 15\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/16maped.webp\"\n              alt=\"Marca 16\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/17ahroyal.webp\"\n              alt=\"Marca 17\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/18kores.webp\"\n              alt=\"Marca 18\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/19milan.webp\"\n              alt=\"Marca 19\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/20jansport.webp\"\n              alt=\"Marca 20\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/21pelikan.webp\"\n              alt=\"Marca 21\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/22colibri.webp\"\n              alt=\"Marca 22\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/23sosoriginal.webp\"\n              alt=\"Marca 23\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n          <div class=\"marca-logo\">\n            <img\n              src=\"https:\/\/raw.githubusercontent.com\/DevUnica\/Shopify\/main\/SVG\/24icopel.webp\"\n              alt=\"Marca 24\"\n              loading=\"lazy\"\n            >\n          <\/div>\n\n        <\/div>\n\n\n      <\/div>\n\n\n      <!-- ======================================================\n           FLECHA IZQUIERDA\n           ====================================================== -->\n\n      <button\n        class=\"marcas-favoritas__arrow marcas-favoritas__arrow--prev\"\n        type=\"button\"\n        aria-label=\"Marcas anteriores\"\n      >\n        <span>‹<\/span>\n      <\/button>\n\n\n      <!-- ======================================================\n           FLECHA DERECHA\n           ====================================================== -->\n\n      <button\n        class=\"marcas-favoritas__arrow marcas-favoritas__arrow--next\"\n        type=\"button\"\n        aria-label=\"Más marcas\"\n      >\n        <span>›<\/span>\n      <\/button>\n\n\n    <\/div>\n\n\n    <!-- ========================================================\n         INDICADORES\n         ======================================================== -->\n\n    <div\n      class=\"marcas-favoritas__dots\"\n      aria-label=\"Navegación de marcas\"\n    ><\/div>\n\n\n  <\/div>\n\n<\/section>\n\n\n<script>\n\n(function () {\n\n  \/* ==========================================================\n     SECCIÓN\n     ========================================================== *\/\n\n  const section =\n    document.getElementById(\n      'marcas-favoritas-{{ section.id }}'\n    );\n\n  if (!section) return;\n\n\n  \/* ==========================================================\n     ELEMENTOS\n     ========================================================== *\/\n\n  const track =\n    section.querySelector(\n      '.marcas-favoritas__track'\n    );\n\n\n  const allLogos =\n    Array.from(\n      section.querySelectorAll(\n        '.marca-logo'\n      )\n    );\n\n\n  const dotsContainer =\n    section.querySelector(\n      '.marcas-favoritas__dots'\n    );\n\n\n  const prev =\n    section.querySelector(\n      '.marcas-favoritas__arrow--prev'\n    );\n\n\n  const next =\n    section.querySelector(\n      '.marcas-favoritas__arrow--next'\n    );\n\n\n  let slides = [];\n\n  let current = 0;\n\n  let autoplay = null;\n\n  let resizeTimer = null;\n\n\n  \/* ==========================================================\n     DETERMINAR CUÁNTAS MARCAS VAN POR SLIDE\n     ========================================================== *\/\n\n  function getItemsPerSlide() {\n\n    const width =\n      window.innerWidth;\n\n\n    \/*\n       DESKTOP\n       12 marcas\n    *\/\n\n    if (width > 1000) {\n      return 12;\n    }\n\n\n    \/*\n       TABLET\n       8 marcas\n    *\/\n\n    if (width > 600) {\n      return 8;\n    }\n\n\n    \/*\n       MÓVIL\n       4 marcas\n    *\/\n\n    return 4;\n  }\n\n\n  \/* ==========================================================\n     CREAR SLIDES\n     ========================================================== *\/\n\n  function buildSlides() {\n\n    const itemsPerSlide =\n      getItemsPerSlide();\n\n\n    \/*\n       Guardar todas las marcas\n    *\/\n\n    const logos =\n      Array.from(allLogos);\n\n\n    \/*\n       Limpiar track\n    *\/\n\n    track.innerHTML = \"\";\n\n\n    slides = [];\n\n\n    \/*\n       Crear nuevos slides\n    *\/\n\n    for (\n      let i = 0;\n      i < logos.length;\n      i += itemsPerSlide\n    ) {\n\n      const slide =\n        document.createElement('div');\n\n\n      slide.className =\n        'marcas-favoritas__slide';\n\n\n      const group =\n        logos.slice(\n          i,\n          i + itemsPerSlide\n        );\n\n\n      group.forEach(\n        function (logo) {\n\n          slide.appendChild(\n            logo.cloneNode(true)\n          );\n\n        }\n      );\n\n\n      track.appendChild(\n        slide\n      );\n\n\n      slides.push(\n        slide\n      );\n\n    }\n\n\n    \/*\n       Crear indicadores\n    *\/\n\n    dotsContainer.innerHTML = \"\";\n\n\n    slides.forEach(\n      function (_, index) {\n\n        const dot =\n          document.createElement(\n            'button'\n          );\n\n\n        dot.className =\n          'marcas-favoritas__dot';\n\n\n        dot.type =\n          'button';\n\n\n        dot.setAttribute(\n          'aria-label',\n          'Página ' +\n          (index + 1)\n        );\n\n\n        dot.addEventListener(\n          'click',\n          function () {\n\n            showSlide(index);\n\n            startAutoplay();\n\n          }\n        );\n\n\n        dotsContainer.appendChild(\n          dot\n        );\n\n      }\n    );\n\n\n    \/*\n       Reiniciar posición\n    *\/\n\n    current = 0;\n\n    showSlide(0);\n\n  }\n\n\n  \/* ==========================================================\n     MOSTRAR SLIDE\n     ========================================================== *\/\n\n  function showSlide(index) {\n\n    if (!slides.length) return;\n\n\n    if (index < 0) {\n\n      index =\n        slides.length - 1;\n\n    }\n\n\n    if (index >= slides.length) {\n\n      index = 0;\n\n    }\n\n\n    current = index;\n\n\n    track.style.transform =\n      'translate3d(-' +\n      (current * 100) +\n      '%, 0, 0)';\n\n\n    const dots =\n      dotsContainer.querySelectorAll(\n        '.marcas-favoritas__dot'\n      );\n\n\n    dots.forEach(\n      function (dot, i) {\n\n        dot.classList.toggle(\n          'active',\n          i === current\n        );\n\n      }\n    );\n\n  }\n\n\n  \/* ==========================================================\n     AUTOPLAY\n     ========================================================== *\/\n\n  function stopAutoplay() {\n\n    if (autoplay) {\n\n      clearInterval(\n        autoplay\n      );\n\n      autoplay = null;\n\n    }\n\n  }\n\n\n  function startAutoplay() {\n\n    stopAutoplay();\n\n\n    \/*\n       Si solo existe un slide,\n       no necesitamos autoplay.\n    *\/\n\n    if (slides.length <= 1) {\n      return;\n    }\n\n\n    autoplay =\n      setInterval(\n        function () {\n\n          showSlide(\n            current + 1\n          );\n\n        },\n        6000\n      );\n\n  }\n\n\n  \/* ==========================================================\n     BOTÓN ANTERIOR\n     ========================================================== *\/\n\n  prev.addEventListener(\n    'click',\n    function () {\n\n      showSlide(\n        current - 1\n      );\n\n      startAutoplay();\n\n    }\n  );\n\n\n  \/* ==========================================================\n     BOTÓN SIGUIENTE\n     ========================================================== *\/\n\n  next.addEventListener(\n    'click',\n    function () {\n\n      showSlide(\n        current + 1\n      );\n\n      startAutoplay();\n\n    }\n  );\n\n\n  \/* ==========================================================\n     PAUSAR CON MOUSE\n     ========================================================== *\/\n\n  section.addEventListener(\n    'mouseenter',\n    stopAutoplay\n  );\n\n\n  section.addEventListener(\n    'mouseleave',\n    startAutoplay\n  );\n\n\n  \/* ==========================================================\n     SWIPE MÓVIL\n     ========================================================== *\/\n\n  let touchStartX = 0;\n\n\n  section.addEventListener(\n    'touchstart',\n    function (event) {\n\n      touchStartX =\n        event.changedTouches[0]\n          .screenX;\n\n      stopAutoplay();\n\n    },\n    {\n      passive: true\n    }\n  );\n\n\n  section.addEventListener(\n    'touchend',\n    function (event) {\n\n      const touchEndX =\n        event.changedTouches[0]\n          .screenX;\n\n\n      const difference =\n        touchStartX -\n        touchEndX;\n\n\n      if (\n        Math.abs(difference) > 50\n      ) {\n\n        if (difference > 0) {\n\n          showSlide(\n            current + 1\n          );\n\n        } else {\n\n          showSlide(\n            current - 1\n          );\n\n        }\n\n      }\n\n\n      startAutoplay();\n\n    },\n    {\n      passive: true\n    }\n  );\n\n\n  \/* ==========================================================\n     RESPONSIVE\n     RECONSTRUIR AL CAMBIAR TAMAÑO\n     ========================================================== *\/\n\n  window.addEventListener(\n    'resize',\n    function () {\n\n      clearTimeout(\n        resizeTimer\n      );\n\n\n      resizeTimer =\n        setTimeout(\n          function () {\n\n            stopAutoplay();\n\n            buildSlides();\n\n            startAutoplay();\n\n          },\n          250\n        );\n\n    }\n  );\n\n\n  \/* ==========================================================\n     INICIALIZAR\n     ========================================================== *\/\n\n  buildSlides();\n\n  startAutoplay();\n\n})();\n\n<\/script>","color_scheme":"","padding_top":0,"padding_bottom":0}},"multicolumn_icon_rTKNUF":{"type":"multicolumn-icon","blocks":{"column_PnJ3NJ":{"type":"column","settings":{"icon":"chat","max_width":28,"max_width_mb":28,"title":"Servicio al cliente","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"text-base","heading_font":"heading","text":"<p>Lun - Vier: 8 A.M a 1 P.M y 2 a 5 P.M<br\/><\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}},"column_xNjRtG":{"type":"column","settings":{"icon":"phone","max_width":28,"max_width_mb":28,"title":"Whatsapp","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"text-base","heading_font":"heading","text":"<p>+57 311 307 2673<\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}},"column_69fN8n":{"type":"column","settings":{"icon":"paperplane","max_width":28,"max_width_mb":28,"title":"Ponte en contacto","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"text-base","heading_font":"heading","text":"<p>info@launica.com.co<\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}},"column_ngN6XL":{"type":"column","settings":{"icon":"map-pin","max_width":32,"max_width_mb":32,"title":"Dirección","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"text-base","heading_fo