</div>

<script>

(function () {

  'use strict';

  /* =========================================================

     CONFIGURACIÓN

     ========================================================= */

  const COOKIE_NAME = 'dlu_selected_store';

  // Número de días durante los cuales

  // recordaremos la selección.

  const COOKIE_DAYS = 30;

  /*

    Sede que se marca como "Estás aquí" cuando el dominio

    NO es ninguno de los dos oficiales (editor de temas,

    vista previa de Shopify, dominio .myshopify.com, etc.).

    En la tienda SUR    -> 'sur'

    En la tienda CENTRO -> 'centro'

  */

  const FALLBACK_STORE = 'centro';

  const STORES = {

    centro: {

      hostname: 'distrilaunica.com.co',

      url: 'https://distrilaunica.com.co/',

      label: 'Centro'

    },

    sur: {

      hostname: 'sur.distrilaunica.com.co',

      url: 'https://sur.distrilaunica.com.co/',

      label: 'Sur'

    }

  };

  // Duración del vuelo del avioncito (ms). Debe coincidir

  // con el atributo dur de la animación en el HTML (3.4s).

  const FLIGHT_MS = 3400;

  // Tiempo que dura el confeti antes de cambiar de sede (ms).

  const SELECT_DELAY_MS = 500;

  // Colores del confeti (blanco y azules de la marca).

  const CONFETTI_COLORS = [

    '#ffffff', '#ffffff', '#1b3c73', '#1881c1'

  ];

  /* =========================================================

     ELEMENTOS

     ========================================================= */

  const modal = document.getElementById('dlu-store-selector');

  if (!modal) return;

  const storeButtons = modal.querySelectorAll('[data-store]');

  const prefersReducedMotion =

    window.matchMedia &&

    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* =========================================================

     IDENTIFICAR TIENDA ACTUAL

     ========================================================= */

  function getCurrentStore() {

    const hostname = window.location.hostname

      .replace(/^www\./, '')

      .toLowerCase();

    if (

      hostname === STORES.sur.hostname ||

      hostname.startsWith('sur.')

    ) {

      return 'sur';

    }

    if (hostname === STORES.centro.hostname) {

      return 'centro';

    }

    // Dominio no oficial (vista previa, editor de temas, etc.)

    return FALLBACK_STORE;

  }

  const currentStore = getCurrentStore();

  /* =========================================================

     COOKIE

     ========================================================= */

  function getCookie(name) {

    const cookies = document.cookie

      ? document.cookie.split('; ')

      : [];

    for (let i = 0; i < cookies.length; i++) {

      const parts = cookies[i].split('=');

      const cookieName = decodeURIComponent(parts.shift());

      const cookieValue = parts.join('=');

      if (cookieName === name) {

        return decodeURIComponent(cookieValue);

      }

    }

    return null;

  }

  function setStoreCookie(store) {

    const maxAge = COOKIE_DAYS * 24 * 60 * 60;

    const hostname = window.location.hostname.toLowerCase();

    let cookie = COOKIE_NAME + '=' + encodeURIComponent(store);

    cookie += '; Path=/';

    cookie += '; Max-Age=' + maxAge;

    cookie += '; SameSite=Lax';

    /*

      Al utilizar .distrilaunica.com.co como dominio,

      la cookie puede ser leída tanto por:

      distrilaunica.com.co

      sur.distrilaunica.com.co

    */

    if (

      hostname === 'distrilaunica.com.co' ||

      hostname.endsWith('.distrilaunica.com.co')

    ) {

      cookie += '; Domain=.distrilaunica.com.co';

    }

    if (window.location.protocol === 'https:') {

      cookie += '; Secure';

    }

    document.cookie = cookie;

  }

  /* =========================================================

     LETRAS QUE SALTAN

     Separa el nombre de la sede en letras para animarlas.

     Se conserva el texto completo para lectores de pantalla.

     ========================================================= */

  modal.querySelectorAll('.dlu-selector__store-word').forEach(function (word) {

    const text = word.textContent.trim();

    word.textContent = '';

    const fullText = document.createElement('span');

    fullText.className = 'dlu-selector__sr';

    fullText.textContent = text;

    word.appendChild(fullText);

    Array.from(text).forEach(function (character, index) {

      const letter = document.createElement('span');

      letter.className = 'dlu-selector__letter';

      letter.setAttribute('aria-hidden', 'true');

      letter.style.setProperty('--i', index);

      letter.textContent = character;

      word.appendChild(letter);

    });

  });

  /* =========================================================

     AVIONCITO

     ========================================================= */

  function flyPlane(card) {

    if (prefersReducedMotion) return;

    // Evita reiniciar el vuelo mientras todavía está en el aire

    if (card.__dluFlying) return;

    const flight = card.querySelector('animateMotion[data-fly]');

    if (!flight || typeof flight.beginElement !== 'function') return;

    card.__dluFlying = true;

    try {

      flight.beginElement();

    } catch (error) {

      card.__dluFlying = false;

      return;

    }

    window.setTimeout(function () {

      card.__dluFlying = false;

    }, FLIGHT_MS + 100);

  }

  storeButtons.forEach(function (card) {

    card.addEventListener('mouseenter', function () {

      flyPlane(card);

    });

    card.addEventListener('focus', function () {

      flyPlane(card);

    });

    card.addEventListener('touchstart', function () {

      flyPlane(card);

    }, { passive: true });

  });

  /* =========================================================

     CONFETI

     Explosión de colores que sale del botón al elegir sede.

     ========================================================= */

  function burstConfetti(card) {

    if (prefersReducedMotion || typeof Element.prototype.animate !== 'function') {

      return;

    }

    const action = card.querySelector('.dlu-selector__store-action');

    if (!action) return;

    const cardRect = card.getBoundingClientRect();

    const actionRect = action.getBoundingClientRect();

    const originX = actionRect.left - cardRect.left + actionRect.width / 2;

    const originY = actionRect.top - cardRect.top + actionRect.height / 2;

    for (let i = 0; i < 22; i++) {

      const piece = document.createElement('span');

      const size = 6 + Math.random() * 8;

      const angle = Math.random() * Math.PI * 2;

      const distance = 70 + Math.random() * 130;

      piece.className = 'dlu-selector__confetti';

      piece.setAttribute('aria-hidden', 'true');

      piece.style.width = size + 'px';

      piece.style.height = size + 'px';

      piece.style.left = (originX - size / 2) + 'px';

      piece.style.top = (originY - size / 2) + 'px';

      piece.style.background =

        CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)];

      // Algunos trozos son cuadrados para dar variedad

      if (i % 3 === 0) {

        piece.style.borderRadius = '2px';

      }

      card.appendChild(piece);

      const dx = Math.cos(angle) * distance;

      const dy = Math.sin(angle) * distance - 30;

      const animation = piece.animate(

        [

          { transform: 'translate(0, 0) rotate(0deg) scale(1)', opacity: 1 },

          {

            transform:

              'translate(' + dx + 'px, ' + dy + 'px) rotate(' +

              (Math.random() * 540 - 270) + 'deg) scale(0.4)',

            opacity: 0

          }

        ],

        {

          duration: 650 + Math.random() * 450,

          easing: 'cubic-bezier(0.15, 0.8, 0.3, 1)',

          fill: 'forwards'

        }

      );

      animation.onfinish = function () {

        piece.remove();

      };

    }

  }

  /* =========================================================

     ABRIR / CERRAR

     ========================================================= */

  function openSelector() {

    modal.style.display = 'flex';

    document.body.style.overflow = 'hidden';

    requestAnimationFrame(function () {

      requestAnimationFrame(function () {

        modal.classList.add('is-visible');

      });

    });

    // Los avioncitos hacen un vuelo de bienvenida

    storeButtons.forEach(function (card, index) {

      window.setTimeout(function () {

        flyPlane(card);

      }, 700 + index * 450);

    });

  }

  function closeSelector() {

    modal.classList.remove('is-visible');

    document.body.style.overflow = '';

    window.setTimeout(function () {

      modal.style.display = 'none';

    }, 300);

  }

  /* =========================================================

     MARCAR SEDE ACTUAL ("Estás aquí")

     ========================================================= */

  storeButtons.forEach(function (button) {

    const store = button.getAttribute('data-store');

    if (store === currentStore) {

      button.classList.add('is-current');

      const actionLabel =

        button.querySelector('[data-action-label]');

      if (actionLabel && STORES[store]) {

        actionLabel.textContent =

          'Continuar en ' + STORES[store].label;

      }

    }

  });

  /* =========================================================

     SELECCIÓN

     ========================================================= */

  storeButtons.forEach(function (button) {

    button.addEventListener('click', function (event) {

      event.preventDefault();

      // Evita doble clic mientras sale el confeti

      if (button.__dluBusy) return;

      const selectedStore =

        button.getAttribute('data-store');

      if (!STORES[selectedStore]) return;

      button.__dluBusy = true;

      /* Guardamos selección */

      setStoreCookie(selectedStore);

      /* Confeti */

      button.classList.add('is-selected');

      burstConfetti(button);

      /*

        Esperamos un instante para que se vea el confeti.

        Si seleccionó la misma tienda en la que ya se encuentra,

        cerramos. Si seleccionó otra, hacemos la redirección.

      */

      window.setTimeout(

        function () {

          if (selectedStore === currentStore) {

            button.classList.remove('is-selected');

            button.__dluBusy = false;

            closeSelector();

            return;

          }

          window.location.href =

            STORES[selectedStore].url;

        },

        prefersReducedMotion ? 0 : SELECT_DELAY_MS

      );

    });

  });

  /* =========================================================

     ¿DEBEMOS MOSTRAR EL POPUP?

     ========================================================= */

  const savedStore = getCookie(COOKIE_NAME);

  const urlParams =

    new URLSearchParams(window.location.search);

  const forceSelector =

    urlParams.get('choose_store') === '1';

  /*

    Mostrar cuando:

    1. No existe selección guardada.

    2. Se solicita manualmente mediante:

       ?choose_store=1

  */

  if (!savedStore || forceSelector) {

    openSelector();

  }

  /* =========================================================

     API MANUAL

     =========================================================

     Permite abrirlo desde otro botón mediante:

     window.DLUStoreSelector.open();

     ========================================================= */

  window.DLUStoreSelector = {

    open: function () {

      openSelector();

    },

    close: function () {

      closeSelector();

    }

  };

})();

</script>
